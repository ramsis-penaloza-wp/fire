  "cards": [
    {
      "dot": "cyan",
      "title": "Shapes and drift",
      "items": [
        "Pipelines turn JSON into a Shape and a SHA-256 fingerprint; values never leave the tentacle",
        "The engine recomputes each fingerprint and rejects a mismatch",
        "A stream is warm after drift.min_samples (20 for OMG)",
        "A new fingerprint on a warm stream that adds, retypes, or drops a required field raises one signal; repeats only count"
      ]
    },
    {
      "dot": "emerald",
      "title": "Engine API",
      "items": [
        "POST /v0/observations: 202 with an ingest report",
        "POST /v0/diagnose: 202, a caller's dossier runs the same diagnosis",
        "GET /v0/systems/{system}/streams: baselines and drift signals",
        "Every /v0 route needs X-FIRE-Token: 401 when wrong, 503 when unset"
      ]
    },
    {
      "dot": "amber",
      "title": "Diagnosis in v0",
      "items": [
        "DiagnosisService runs reasoner, then narrator, then notifier",
        "Only echo, template, and console are wired; other providers fail at startup",
        "Evidence it cannot build is a MISSING fragment, never a guess"
      ]
    },
    {
      "dot": "violet",
      "title": "Config, not code",
      "items": [
        "config/fire.yml: token env var, providers, tentacle batching",
        "config/systems/<system>.yml: sources, manifest, drift policy",
        "Kinesis, DynamoDB stream, SNS, and S3 sources are declared but have no reader yet"
      ]
    }
  ]
