# Mutating HTTP endpoints require this token (X-FIRE-Token).
# Set locally; never commit a real value.
FIRE_API_TOKEN=

# Narrator (OpenAI-compatible). Never commit real keys.
FIRE_NARRATOR_BASE_URL=https://api.openai.com/v1
FIRE_NARRATOR_API_KEY=
FIRE_NARRATOR_MODEL=gpt-4.1-mini

# System One reasoner (Laya local / Jev hosted). Optional in v0 (echo stub).
# FIRE_SYSTEMONE_BASE_URL=http://127.0.0.1:8080/v1/systemone
# FIRE_SYSTEMONE_API_KEY=

# Tentacle (python -m fire.apps.tentacle): the body's base URL. It sends with FIRE_API_TOKEN.
FIRE_BODY_URL=http://127.0.0.1:8000

# OMG (config/systems/omg.yml).
# Path to order-management-gateway/scripts/event_chains/event_chains_graph.json.
# Unset: the engine still starts and reports OMG's inventory as missing.
OMG_MANIFEST_PATH=
# Tentacle sources. Unset: the tentacle skips that source and says so.
# Path to order-management-gateway/scripts/test_payloads (replay of its WorkUnit samples).
OMG_REPLAY_PATH=
# Upstream base URLs of the inbound proxies (:8120 and :8130). Locally http://localhost:8020
# (the OMG API) and http://localhost:8030 (the validation engine).
OMG_API_UPSTREAM=
OMG_VALIDATION_UPSTREAM=
# Where the OTLP receiver listens, host:port. Locally 127.0.0.1:4318, the endpoint of
# dev/omg/otel-collector-config.yml; on Linux 0.0.0.0:4318 so OMG's collector reaches it.
OMG_OTLP_LISTEN=
# Resource names, the same in every region; local names in dev/omg/README.md.
# The event sources are read from step 1.8 and the transmission bucket from step 1.7.
OMG_EVENTS_STREAM=
OMG_EVENTS_TABLE=
OMG_RX_UPDATES_STREAM=
OMG_CARRIER_EVENTS_TOPIC=
OMG_FINANCIALS_EVENTS_TOPIC=
OMG_TRANSMISSION_BUCKET=
